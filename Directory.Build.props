<Project>
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.wapproj'">
		<!--
			MSB3270: Architecture mismatch warning/error.
			The WAP packaging project (CaffeinePro Setup.wapproj) builds as AnyCPU/MSIL but intentionally
			references platform-specific (x86/x64/ARM64) DLLs during packaging. Microsoft.AppxPackage.Targets
			promotes this to an error by default — suppress it by pre-setting the property here
			(Directory.Build.props is imported before any SDK/platform targets, so this wins the race).

			Scoped to the packaging project: applying it to CaffeinePro.csproj as well would hide genuine
			architecture mismatches in the application itself.
		-->
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3270</MSBuildWarningsAsMessages>
	</PropertyGroup>
</Project>
