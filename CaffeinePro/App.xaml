<Application
    x:Class="CaffeinePro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:caffeinePro="clr-namespace:CaffeinePro"
    xmlns:controls="clr-namespace:CaffeinePro.Controls"
    xmlns:converters="clr-namespace:CaffeinePro.Converters"
    xmlns:loc="clr-namespace:CaffeinePro.Localization"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Icons.xaml" />
                <ResourceDictionary>

                    <SolidColorBrush x:Key="ActiveColor" Color="#FF443E" />
                    <SolidColorBrush x:Key="InactiveColor" Color="{x:Static SystemColors.GrayTextColor}" />
                    <SolidColorBrush x:Key="TemporarilyInactiveColor" Color="Purple" />

                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <converters:MinutesToTimeStringConverter x:Key="MinutesToTimeString" />
            <converters:MinutesToActualDateTimeStringConverter x:Key="MinutesToActualDateTime" />
            <converters:TimeIsPassedToTextDecorationsConverter x:Key="TimeIsPassedToTextDecorations" />
            <converters:TimeIsPassedToBorderBrushConverter x:Key="TimeIsPassedToBorderBrush" />
            <converters:TimeIsPassedToOpacityConverter x:Key="TimeIsPassedToOpacity" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToOpacityConverter x:Key="BoolToOpacity" />
            <converters:EnumToDescriptionConverter x:Key="EnumToDescription" />
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converters:DateToEnabledConverter x:Key="DateToEnabled" />
            <converters:DoubleToIntConverter x:Key="DoubleToInt" />
            <converters:ValueEqualsParameterConverter x:Key="ValueEqualsParameter" />
            <converters:ValueNotEqualsParameterConverter x:Key="ValueNotEqualsParameter" />
            <converters:ValueNotEqualsParameterToVisibilityConverter x:Key="ValueNotEqualsParameterToVisibility" />
            <converters:NotConverter x:Key="Not" />
            <converters:IsNullConverter x:Key="IsNull" />
            <converters:HalfConverter x:Key="Half" />
            <converters:TwoValuesNotEqualToVisibility x:Key="TwoValuesNotEqualToVisibility" />
            <converters:AwakenessTimeNotEqualsToVisibilityConverter x:Key="AwakenessTimeNotEqualsToVisibilityConverter" />
            <converters:HoursMinutesToStringConverter x:Key="HoursMinutesToString" />
            <converters:AwakenessToDisplayTextConverter x:Key="AwakenessToDisplayText" />
            <converters:QuarterTimeConverter x:Key="QuarterTime" />

            <Style x:Key="NoHighlightMenuItemStyle" TargetType="{x:Type MenuItem}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border
                                x:Name="Border"
                                HorizontalAlignment="Stretch"
                                Background="Transparent">
                                <ContentPresenter
                                    Margin="10,2"
                                    HorizontalAlignment="Stretch"
                                    ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true" />
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--
                The tray menu is its own visual root, so it does not inherit the reading direction
                or the script font from anywhere - both are bound here, as on every window.
            -->
            <ContextMenu
                x:Key="TrayContextMenu"
                DataContext="{Binding Source={x:Static caffeinePro:App.CurrentApp}}"
                FlowDirection="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=FlowDirection}"
                NumberSubstitution.CultureSource="User"
                NumberSubstitution.Substitution="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=DigitSubstitution}"
                FontFamily="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=FontFamily}"
                Opened="OnTrayContextMenuOpened">
                <MenuItem
                    HorizontalContentAlignment="Center"
                    StaysOpenOnClick="True"
                    Style="{StaticResource NoHighlightMenuItemStyle}">
                    <MenuItem.Header>
                        <controls:StatusControl />
                    </MenuItem.Header>
                </MenuItem>
                <Separator />

                <!--  The shortcut is shown alongside, so the menu also teaches it  -->
                <MenuItem
                    Click="OnBlackoutMenu"
                    Header="{loc:Loc Menu_BlackoutScreen}"
                    InputGestureText="{Binding AppSettings.BlackoutHotKey.DisplayText, Mode=OneWay}"
                    ToolTip="{loc:Loc Menu_BlackoutScreen_ToolTip}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="WeatherMoon24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />

                <MenuItem Header="{loc:Loc Menu_Settings}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Settings24" />
                    </MenuItem.Icon>

                    <MenuItem.Items>
                        <MenuItem StaysOpenOnClick="True" Style="{StaticResource NoHighlightMenuItemStyle}">
                            <MenuItem.Header>
                                <controls:StartupOptionsControl />
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem
                            Margin="10"
                            StaysOpenOnClick="True"
                            Style="{StaticResource NoHighlightMenuItemStyle}">
                            <MenuItem.Header>
                                <ui:ToggleSwitch
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Content="{loc:Loc Menu_StartWithWindows}"
                                    IsChecked="{Binding Mode=TwoWay, Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartWithWindows}" />
                            </MenuItem.Header>
                        </MenuItem>

                        <!--
                            Every language names itself in its own script, so the list stays
                            readable no matter which language the rest of the menu is in.
                        -->
                        <MenuItem Header="{loc:Loc Menu_Language}" ItemsSource="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=Languages}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Margin="0,0,6,0" Symbol="LocalLanguage24" />
                            </MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                    <EventSetter Event="Click" Handler="OnLanguageMenu" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </MenuItem.Items>
                </MenuItem>
                <Separator />

                <MenuItem Click="OnSendFeedback" Header="{loc:Loc Menu_SendFeedback}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="PersonFeedback20" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnAboutMenu" Header="{loc:Loc Menu_About}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Info20" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnExitMenu" Header="{loc:Loc Menu_Quit}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowExit20" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <Canvas
                x:Key="InactiveIconCanvas"
                Width="16"
                Height="16">
                <!--  Base Icon  -->
                <Image
                    Width="16"
                    Height="16"
                    Source="pack://application:,,,/Resources/Coffee16.ico" />
            </Canvas>

            <Canvas
                x:Key="ActiveIconCanvas"
                Width="16"
                Height="16">
                <!--  Base Icon  -->
                <Image
                    Width="16"
                    Height="16"
                    Source="pack://application:,,,/Resources/Coffee16.ico" />
                <!--  Overlay Circle  -->
                <Ellipse
                    Canvas.Left="12"
                    Canvas.Top="12"
                    Width="6"
                    Height="6"
                    Fill="{StaticResource ActiveColor}" />
            </Canvas>

            <Canvas
                x:Key="TemporarilyInactiveIconCanvas"
                Width="16"
                Height="16">
                <!--  Base Icon  -->
                <Image
                    Width="16"
                    Height="16"
                    Source="pack://application:,,,/Resources/Coffee16.ico" />
                <!--  Overlay Circle  -->
                <Ellipse
                    Canvas.Left="12"
                    Canvas.Top="12"
                    Width="6"
                    Height="6"
                    Fill="{StaticResource TemporarilyInactiveColor}" />
            </Canvas>


            <tb:TaskbarIcon
                x:Key="TrayIcon"
                ContextMenu="{StaticResource TrayContextMenu}"
                DataContext=""
                MenuActivation="LeftOrRightClick"
                ToolTipText="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=KeepAwakeService.StatusText}" />

        </ResourceDictionary>
    </Application.Resources>

</Application>