<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x86</Platform>
    <PublishDir>bin\publish\win-x86\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!--
      Must carry the Windows SDK version, exactly as in CaffeinePro.csproj. The bare
      "net10.0-windows" that Visual Studio writes here drops the Windows SDK projections, and
      Routines.cs fails to compile because Windows.ApplicationModel.StartupTask disappears.
    -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <!--
      Self-contained, so the download runs on a machine with no .NET installed - Windows ships no
      .NET Core runtime in-box. Note that PublishTrimmed cannot be used to claw back the size: the
      .NET SDK disables trimming for WPF because it is not trim-compatible.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Without compression the single file is 239 MB, because ReadyToRun natively compiles the whole
      bundled framework, WPF included. Compressing brings it to 90 MB at the cost of a decompression
      pass on launch; dropping ReadyToRun instead would give 77 MB but a slower cold start, which is
      the wrong trade for an app that launches at sign-in.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
