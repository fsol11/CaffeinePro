<local:NotificationWindowBase
    x:Class="CaffeinePro.Windows.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CaffeinePro.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CaffeinePro.Windows"
    xmlns:loc="clr-namespace:CaffeinePro.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:CaffeinePro.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    FlowDirection="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=FlowDirection}"
    NumberSubstitution.CultureSource="User"
    NumberSubstitution.Substitution="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=DigitSubstitution}"
    FontFamily="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=FontFamily}"
    Foreground="{DynamicResource WindowForeground}"
    Icon="/Resources/Coffee.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BitmapImage x:Key="Coffee" UriSource="/Resources/Coffee-Transparent.png" />
    </Window.Resources>

    <StackPanel
        Margin="5"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <ui:TitleBar
            Height="28"
            Padding="0"
            ShowMaximize="False"
            ShowMinimize="False"
            ToolTip="{loc:Loc Notification_AskLater}" />

        <StackPanel
            Margin="20,10,20,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="70"
                Margin="0,0,20,0"
                VerticalAlignment="Top"
                FlowDirection="LeftToRight"
                Source="{StaticResource Coffee}" />

            <StackPanel>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    TextWrapping="NoWrap">
                    <Run Text="{loc:Loc Notification_Question}" />
                </ui:TextBlock>

                <!--
                    The time is offered, not dictated: the prompt opens on the default awakeness,
                    and the drop-down is the same picker the tray menu uses, so another time can be
                    dialled in without dismissing the prompt and going to the menu.

                    Bound through the window rather than through the DataContext: the control sets
                    its own DataContext to itself, so an inherited binding would look for the
                    awakeness on the control and silently find nothing.
                -->
                <controls:AwakenessViewControl
                    Margin="0,8,0,0"
                    AwakenessValue="{Binding Awakeness, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                    InStartupOptions="False"
                    NewAwakenessSelected="OnNewAwakenessSelected" />

                <!--
                    The button above names the clock time the awakeness ends at. For a relative one
                    ("for 2 hours") the duration it was picked as is worth saying too, so it is
                    spelled out underneath.
                -->
                <ui:TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Visibility="{Binding Awakeness.IsRelative, Converter={StaticResource BoolToVis}}">
                    <Run FontSize="10" Text="{loc:Loc TimeSlider_For}" />
                    <Run Text="{Binding Awakeness.RelativeSpan, Converter={StaticResource MinutesToTimeString}, Mode=OneWay}" />
                </ui:TextBlock>

                <ui:TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Visibility="{Binding AfterwardsAction, Converter={StaticResource ValueNotEqualsParameterToVisibility}, ConverterParameter={x:Static services:SessionAction.None}}">
                    <Run FontSize="10" Text="{loc:Loc Startup_SectionAfterwards}" />
                    <Run Text="{Binding AfterwardsAction, Converter={StaticResource EnumToDescription}, Mode=OneWay}" />
                </ui:TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel
            Margin="10,20,10,10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:TextBlock
                Padding="5,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding Version}"
                TextWrapping="Wrap" />

            <ui:Button
                Width="150"
                Height="40"
                Click="Activate_Click"
                IsDefault="True">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Top" TextAlignment="Center">
                        <Run Foreground="{StaticResource ActiveColor}" Text="●" />
                        <Run Text=" " />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc Notification_Activate}" />
                </StackPanel>
            </ui:Button>

            <ui:Button
                Width="150"
                Height="40"
                Margin="20,0,0,0"
                Click="IgnoreForToday_Click">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Symbol="Pause20" />
                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc Notification_IgnoreForToday}" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

    </StackPanel>
</local:NotificationWindowBase>