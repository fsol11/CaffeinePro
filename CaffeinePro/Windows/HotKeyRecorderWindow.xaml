<ui:FluentWindow
    x:Class="CaffeinePro.Windows.HotKeyRecorderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Change Shortcut"
    Width="420"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    ExtendsContentIntoTitleBar="True"
    Icon="/Resources/Coffee.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,20">
        <ui:TitleBar
            Title="Change Shortcut"
            Height="29"
            Padding="7,0,0,0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ui:TextBlock
            Margin="24,16,24,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Text="Press the key combination you want to use." />

        <Border
            Margin="24,16,24,0"
            Padding="12,18"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ui:TextBlock
                x:Name="PreviewText"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Waiting..." />
        </Border>

        <ui:TextBlock
            x:Name="StatusText"
            Margin="24,10,24,0"
            HorizontalAlignment="Center"
            FontSize="11"
            Opacity="0.7"
            Text="At least one modifier (Ctrl, Alt, Shift or Win) is required."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <StackPanel
            Margin="24,20,24,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <ui:Button
                x:Name="SaveButton"
                Width="120"
                Appearance="Primary"
                Click="Save_Click"
                Content="Save"
                IsEnabled="False" />
            <ui:Button
                Width="120"
                Margin="12,0,0,0"
                Click="Cancel_Click"
                Content="Cancel" />
        </StackPanel>

        <ui:TextBlock
            Margin="24,14,24,0"
            HorizontalAlignment="Center"
            FontSize="11"
            Opacity="0.6"
            Text="Escape cancels. Backspace removes the shortcut." />
    </StackPanel>
</ui:FluentWindow>
