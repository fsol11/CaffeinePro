<Window
    x:Class="CaffeinePro.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:CaffeinePro.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Foreground="{DynamicResource WindowForeground}"
    KeyDown="NotificationWindow_OnKeyDown"
    Loaded="NotificationWindow_OnLoaded"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BitmapImage x:Key="Coffee" UriSource="/Resources/Coffee.png" />
    </Window.Resources>

    <StackPanel
        Margin="5"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <ui:TitleBar
            Height="28"
            Padding="0"
            ShowMaximize="False"
            ShowMinimize="False"
            ToolTip="Ask Later" />

        <StackPanel
            Margin="50,10,50,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="50"
                Height="50"
                Margin="0,0,40,0"
                Source="{StaticResource Coffee}">
                <Image.Clip>
                    <RectangleGeometry
                        RadiusX="3"
                        RadiusY="3"
                        Rect="0,0,50,50" />
                </Image.Clip>
            </Image>

            <StackPanel>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    TextWrapping="NoWrap">
                    <Run Text="Keep the computer awake?" />
                </ui:TextBlock>

                <!--  Mirrors the FOR / UNTIL summary of TimeSliderControl  -->
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Visibility="{Binding Awakeness.IsRelative, Converter={StaticResource BoolToVis}}">
                    <Run FontSize="14" Text="FOR" />
                    <Run Text="{Binding Awakeness.RelativeSpan, Converter={StaticResource MinutesToTimeString}, Mode=OneWay}" />
                </ui:TextBlock>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Visibility="{Binding Awakeness.IsRelative, Converter={StaticResource BoolToVis}}">
                    <Run FontSize="10" Text="UNTIL" />
                    <Run Text="{Binding Awakeness.EndDateTimeText, Mode=OneWay}" />
                </ui:TextBlock>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Visibility="{Binding Awakeness.IsRelative, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                    <Run FontSize="14" Text="UNTIL" />
                    <Run Text="{Binding Awakeness.EndDateTimeText, Mode=OneWay}" />
                </ui:TextBlock>

                <ui:TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Visibility="{Binding AfterwardsAction, Converter={StaticResource ValueNotEqualsParameterToVisibility}, ConverterParameter={x:Static services:SessionAction.None}}">
                    <Run FontSize="10" Text="AFTERWARDS" />
                    <Run Text="{Binding AfterwardsAction, Converter={StaticResource EnumToDescription}, Mode=OneWay}" />
                </ui:TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <ui:TextBlock
                Padding="5,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding Version}"
                TextWrapping="Wrap" />

            <ui:Button
                Width="123"
                Height="40"
                Click="Activate_Click"
                IsDefault="True">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Top" TextAlignment="Center">
                        <Run Foreground="{StaticResource ActiveColor}" Text="●" />
                        <Run Text=" " />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Text="Activate" />
                </StackPanel>
            </ui:Button>

            <ui:Button
                Height="40"
                Margin="10,0,0,0"
                Click="IgnoreForToday_Click">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Symbol="Pause20" />
                    <TextBlock VerticalAlignment="Center" Text="Ignore For Today" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

    </StackPanel>
</Window>