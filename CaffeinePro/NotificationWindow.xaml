<Window
    x:Class="CaffeinePro.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Foreground="{DynamicResource WindowForeground}"
    KeyDown="NotificationWindow_OnKeyDown"
    Loaded="NotificationWindow_OnLoaded"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BitmapImage x:Key="Coffee" UriSource="/Resources/Coffee.png" />
    </Window.Resources>

    <StackPanel
        Margin="5"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <ui:TitleBar
            Height="28"
            Padding="0"
            ShowMaximize="False"
            ShowMinimize="False"
            ToolTip="Ask Later" />

        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="50"
                Height="50"
                Margin="0,0,10,0"
                Source="{StaticResource Coffee}">
                <Image.Clip>
                    <RectangleGeometry
                        RadiusX="3"
                        RadiusY="3"
                        Rect="0,0,50,50" />
                </Image.Clip>
            </Image>

            <StackPanel>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    TextWrapping="NoWrap">
                    <Run Text="Keep the computer awake" />
                    <Run Text=" " />
                </ui:TextBlock>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    TextWrapping="NoWrap">
                    <Run x:Name="TxtAwakeness" />
                    <Run Text="?" />
                </ui:TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <ui:TextBlock
                Padding="5,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding Version}"
                TextWrapping="Wrap" />

            <ui:Button
                Width="123"
                Height="40"
                Click="Activate_Click"
                IsDefault="True">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Top" TextAlignment="Center">
                        <Run Foreground="{StaticResource ActiveColor}" Text="●" />
                        <Run Text=" " />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Text="Activate" />
                </StackPanel>
            </ui:Button>
            <ui:Button
                Height="40"
                Margin="10,0,0,0"
                Click="AlwaysActivate_Click"
                IsDefault="True">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Top" TextAlignment="Center">
                        <Run Foreground="{StaticResource ActiveColor}" Text="●" />
                        <Run Text=" " />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Text="Always Activate" />
                </StackPanel>
            </ui:Button>
            <ui:Button
                Height="40"
                Margin="10,0,0,0"
                Click="IgnoreForToday_Click"
                Content="🤫 Ignore For Today" />
        </StackPanel>

    </StackPanel>
</Window>