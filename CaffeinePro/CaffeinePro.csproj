<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>CaffeinePro</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CaffeinePro.App</StartupObject>
    <ApplicationIcon>Resources\Coffee.ico</ApplicationIcon>
    <Copyright>Copyright (c) 2026 Lotrasoft Inc.</Copyright>
    <Description>Keeps Windows awake</Description>
    <Title>Caffeine Pro</Title>
    <!-- Drives AssemblyVersion and FileVersion, and the Version shown in the About window. -->
    <Version>3.1</Version>
    <RepositoryUrl>https://github.com/fsol11/CaffeinePro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <UseWindowsForms>False</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Notification.Wpf" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\about-back.jpg" />
    <None Remove="Resources\about-back.jpg" />
    <None Remove="Resources\Coffee-Transparent.png" />
    <None Remove="Resources\Coffee16.ico" />
    <Resource Include="Resources\Coffee-Transparent.png" />
    <Resource Include="Resources\Coffee16.ico" />
    <Resource Include="Resources\Coffee.ico" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Controls\AwakenessViewControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\AwakenessViewControl.xaml.cs">
      <SubType>Code</SubType>
      <DependentUpon>AwakenessViewControl.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>