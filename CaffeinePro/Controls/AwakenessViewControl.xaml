<UserControl
    x:Class="CaffeinePro.Controls.AwakenessViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:caffeinePro="clr-namespace:CaffeinePro"
    xmlns:classes="clr-namespace:CaffeinePro.Classes"
    xmlns:controls="clr-namespace:CaffeinePro.Controls"
    xmlns:converters="clr-namespace:CaffeinePro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="50"
    Padding="0,0,0,0"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">

    <!--
        The whole control is the drop-down: the current awakeness is the button's content, so
        clicking anywhere on the text opens the time picker. The button draws its own chevron, so
        no separate affordance is needed next to it.
    -->
    <ui:DropDownButton
        MinWidth="220"
        Padding="10,4"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        ToolTip="Set the Time">
        <ui:DropDownButton.Content>
            <!--  Grid, so the two states overlap and the button does not resize as they swap  -->
            <Grid HorizontalAlignment="Center">
                <StackPanel
                    x:Name="RelativeTimePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AwakenessValue.AwakenessType}" Value="{x:Static classes:Awakeness+AwakenessTypes.Relative}" />
                                        <Condition Binding="{Binding InStartupOptions}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Opacity="0.5"
                        Text="For |" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource HoursMinutesToString}">
                                <Binding Path="AwakenessValue.RelativeSpan.Hours" />
                                <Binding Path="AwakenessValue.RelativeSpan.Minutes" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AwakenessValue.IsRelative}" Value="True" />
                                        <Condition Binding="{Binding InStartupOptions}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Opacity="0.5"
                        Text="Until |" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="{Binding AwakenessValue.EndDateText}"
                        Visibility="{Binding ShouldShowDate, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding AwakenessValue.EndTimeText}"
                        Visibility="{Binding AwakenessValue.IsIndefinite, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}" />
                </StackPanel>
            </Grid>
        </ui:DropDownButton.Content>

        <ui:DropDownButton.Flyout>
            <ContextMenu x:Name="SetTimeFlyout" Opened="SetTimeMenuOpened">
                <MenuItem StaysOpenOnClick="True" Style="{StaticResource NoHighlightMenuItemStyle}">
                    <MenuItem.Header>
                        <StackPanel HorizontalAlignment="Stretch">

                            <controls:TimeSliderControl
                                x:Name="RelativeTimeSlider"
                                HorizontalAlignment="Stretch"
                                InStartupOptions="{Binding InStartupOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <ui:Button
                                Margin="10"
                                HorizontalAlignment="Center"
                                Click="ApplyButton_OnClick">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                                        <Setter Property="Content" Value="Apply &amp; Activate" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InStartupOptions}" Value="True">
                                                <Setter Property="Content" Value="Apply" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <!--
                                Outside the startup options the picker also offers the default
                                awakeness, so it can be adopted without going through the settings.
                                In the startup options the default IS what is being edited, so the
                                section would be circular and is hidden from code-behind.
                            -->
                            <StackPanel x:Name="DefaultAwakenessSection" Margin="10,0,10,8">
                                <Separator Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Two columns, so the hint lines up with the awakeness text rather than with the label  -->
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Top"
                                            Opacity="0.5"
                                            Text="Default |" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartupAwakeness, Converter={StaticResource AwakenessToDisplayText}}" />

                                            <!--  A relative default says nothing about when it actually ends, so spell that out  -->
                                            <TextBlock
                                                x:Name="DefaultAwakenessHint"
                                                Margin="0,1,0,0"
                                                FontSize="10"
                                                Opacity="0.6"
                                                Text="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartupAwakeness, Converter={StaticResource AwakenessToDisplayText}, ConverterParameter={x:Static converters:AwakenessTextPart.AbsoluteHint}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <!--  Nothing to add for absolute or indefinite defaults  -->
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Click="SetToDefaultButton_OnClick"
                                        Content="Set to Default"
                                        ToolTip="Use the default awakeness" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </MenuItem.Header>

                </MenuItem>
            </ContextMenu>
        </ui:DropDownButton.Flyout>
    </ui:DropDownButton>

</UserControl>
