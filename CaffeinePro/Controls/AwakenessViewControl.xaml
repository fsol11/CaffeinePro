<UserControl
    x:Class="CaffeinePro.Controls.AwakenessViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:classes="clr-namespace:CaffeinePro.Classes"
    xmlns:controls="clr-namespace:CaffeinePro.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="50"
    Padding="0,0,0,0"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">

    <Border
        Padding="5,2"
        Background="Transparent"
        BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
        BorderThickness="2"
        CornerRadius="4">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <StackPanel x:Name="RelativeTimePanel" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding AwakenessValue.AwakenessType}" Value="{x:Static classes:Awakeness+AwakenessTypes.Relative}" />
                                            <Condition Binding="{Binding InStartupOptions}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock
                            Width="75"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="For |"
                            TextAlignment="Right" />
                        <Border
                            Width="150"
                            Margin="4,2"
                            Padding="8,1"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal">

                                <TextBlock VerticalAlignment="Center" TextAlignment="Left">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}h : {1}m">
                                            <Binding Path="AwakenessValue.RelativeSpan.Hours" />
                                            <Binding Path="AwakenessValue.RelativeSpan.Minutes" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text=" " />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding AwakenessValue.IsRelative}" Value="True" />
                                            <Condition Binding="{Binding InStartupOptions}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock
                            Width="75"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Opacity="0.5"
                            Text="Until |"
                            TextAlignment="Right" />

                        <Border
                            Width="150"
                            Margin="4,2"
                            Padding="8,1"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    Text="{Binding AwakenessValue.EndDateText}"
                                    Visibility="{Binding ShouldShowDate, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding AwakenessValue.EndTimeText}" Visibility="{Binding AwakenessValue.IsIndefinite, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </StackPanel>
                <ui:DropDownButton
                    Padding="5,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTip="Set the Time">
                    <ui:DropDownButton.Icon>
                        <ui:SymbolIcon
                            Height="24"
                            Filled="False"
                            Symbol="Clock24" />
                    </ui:DropDownButton.Icon>
                    <ui:DropDownButton.Flyout>

                        <ContextMenu Opened="SetTimeMenuOpened">
                            <MenuItem
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="MenuItemIndefinitely_OnClick"
                                Tag="{x:Null}">
                                <MenuItem.Header>
                                    <TextBlock HorizontalAlignment="Center" Text="♾️ Indefinitely" />
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem StaysOpenOnClick="True" Style="{StaticResource NoHighlightMenuItemStyle}">
                                <MenuItem.Header>
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <controls:TimeSliderControl x:Name="RelativeTimeSlider" HorizontalAlignment="Stretch" />

                                        <Button
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            Click="ApplyButton_OnClick"
                                            Content="Apply &amp; Activate" />
                                    </StackPanel>
                                </MenuItem.Header>

                            </MenuItem>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
