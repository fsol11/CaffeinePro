<UserControl
    x:Class="CaffeinePro.Controls.StartupOptionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:caffeinePro="clr-namespace:CaffeinePro"
    xmlns:controls="clr-namespace:CaffeinePro.Controls"
    xmlns:loc="clr-namespace:CaffeinePro.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:CaffeinePro.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="AfterwardsRadioButtonStyle"
            BasedOn="{StaticResource {x:Type RadioButton}}"
            TargetType="{x:Type RadioButton}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Left">
            <Grid Margin="0,4,0,0">
                <Border
                    Margin="0,9,0,0"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="4"
                    CornerRadius="8" />
                <Border
                    Margin="18,2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        Padding="16,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorInverseBrush}"
                        Opacity="0.7"
                        Text="{loc:Loc Startup_SectionDefault}" />
                </Border>
                <Border Margin="0,9,0,0" Padding="12,16,12,12">
                    <StackPanel>
                        <controls:AwakenessViewControl
                            x:Name="StartupAwakenessControl"
                            HorizontalAlignment="Center"
                            AwakenessValue="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartupAwakeness, Mode=TwoWay}"
                            InStartupOptions="True">
                            <controls:AwakenessViewControl.Style>
                                <Style TargetType="{x:Type controls:AwakenessViewControl}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AwakenessViewControl.Style>

                        </controls:AwakenessViewControl>

                        <TextBlock
                            Name="CopyLink"
                            Margin="10,5"
                            HorizontalAlignment="Right"
                            TextWrapping="Wrap">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource AwakenessTimeNotEqualsToVisibilityConverter}">
                                    <Binding Path="AppSettings.StartupAwakeness" Source="{x:Static caffeinePro:App.CurrentApp}" />
                                    <Binding Path="KeepAwakeService.Awakeness" Source="{x:Static caffeinePro:App.CurrentApp}" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                            <Hyperlink Click="SetToCurrentValue_Click">
                                <Run Text="{loc:Loc Startup_CopyFromCurrentValue}" />
                            </Hyperlink>
                        </TextBlock>

                        <StackPanel Margin="0,6,0,0" Orientation="Vertical">
                            <RadioButton
                                Margin="0,2"
                                GroupName="Startup"
                                IsChecked="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartActive, Converter={StaticResource IsNull}}">
                                <RadioButton.Content>
                                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                        <TextBlock
                                            Padding="0,10,0,0"
                                            VerticalAlignment="Center"
                                            Text="{loc:Loc Startup_AskMe}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Text="{loc:Loc Startup_OnlyIfTimeNotPassed}" />
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton
                                Margin="0,2"
                                Click="StartActive_OnClick"
                                GroupName="Startup"
                                IsChecked="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartActive}">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock
                                        Padding="0,10,0,0"
                                        VerticalAlignment="Center"
                                        Text="{loc:Loc Startup_AutoSetToDefault}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{loc:Loc Startup_OnlyIfTimeNotPassed}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                Margin="0,2"
                                Content="{loc:Loc Startup_StayInactive}"
                                GroupName="Startup"
                                IsChecked="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.StartActive, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Border
                    Margin="0,9,0,0"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="4"
                    CornerRadius="8" />
                <Border
                    Margin="18,2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        Padding="16,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorInverseBrush}"
                        Opacity="0.7"
                        Text="{loc:Loc Startup_SectionMethod}" />
                </Border>
                <Border Margin="0,9,0,0" Padding="12,16,12,12">
                    <StackPanel>
                        <RadioButton
                            Margin="0,2"
                            Content="{loc:Loc Startup_SimulateKeyboardMouse}"
                            GroupName="AwakeMethod"
                            IsChecked="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.AllowScreenSaver, Converter={StaticResource Not}, Mode=TwoWay}" />
                        <RadioButton
                            Margin="0,2"
                            GroupName="AwakeMethod"
                            IsChecked="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings.AllowScreenSaver, Mode=TwoWay}">
                            <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                                <TextBlock
                                    Padding="0,10,0,0"
                                    VerticalAlignment="Center"
                                    Text="{loc:Loc Startup_AllowScreensaver}" />
                                <TextBlock
                                    VerticalAlignment="Top"
                                    FontSize="10"
                                    Text="{loc:Loc Startup_AllowScreensaver_Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  OPTIONS  -->
            <Grid Margin="0,10,0,0">
                <Border
                    Margin="0,9,0,0"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="4"
                    CornerRadius="8" />
                <Border
                    Margin="18,2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        Padding="16,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorInverseBrush}"
                        Opacity="0.7"
                        Text="{loc:Loc Startup_SectionOptions}" />
                </Border>
                <Border Margin="0,9,0,0" Padding="12,16,12,12">
                    <StackPanel DataContext="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings}">
                        <StackPanel Margin="0,4" Orientation="Horizontal">
                            <Image
                                Width="20"
                                Margin="0,0,8,0"
                                FlowDirection="LeftToRight"
                                Source="{StaticResource BatteryPausedIcon}" />
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{loc:Loc Startup_InactiveOnBattery}"
                                IsChecked="{Binding InactiveWhenOnBattery, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Blackout screen shortcut: shows the current combination and opens the recorder to change it  -->
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Width="20"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="WeatherMoon20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{loc:Loc Startup_BlackoutTrigger}"
                                ToolTip="{loc:Loc Menu_BlackoutScreen_ToolTip}" />
                            <ui:Button
                                Margin="10,0,0,0"
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Click="ChangeBlackoutHotKey_Click"
                                Content="{Binding BlackoutHotKey.DisplayText, Mode=OneWay}"
                                FontSize="12"
                                ToolTip="{loc:Loc Startup_ChangeShortcut_ToolTip}" />
                        </StackPanel>
                        <TextBlock
                            Margin="28,4,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{loc:Loc Startup_ShortcutInUse}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=HotKeyService.IsBlackoutHotKeyRegistered, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  AFTERWARDS  -->
            <Grid Margin="0,10,0,0">
                <Border
                    Margin="0,9,0,0"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="4"
                    CornerRadius="8" />
                <Border
                    Margin="18,2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        Padding="16,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorInverseBrush}"
                        Opacity="0.7"
                        Text="{loc:Loc Startup_SectionAfterwards}" />
                </Border>
                <Border Margin="0,9,0,0" Padding="12,16,12,12">
                    <StackPanel Margin="0,2" DataContext="{Binding Source={x:Static caffeinePro:App.CurrentApp}, Path=AppSettings}">
                        <!--  Group 1: Do Nothing  -->
                        <UniformGrid Columns="2">
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.None}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="Prohibited20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_None}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <Separator Margin="0,2" />
                        <!--  Group 2: Lock, Sign Out, Exit, Sleep  -->
                        <UniformGrid Columns="2">
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.Lock}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="LockClosed20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_Lock}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.SignOut}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="PersonArrowLeft20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_SignOut}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.Quit}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="ArrowExit20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc Menu_Quit}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.Sleep}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="WeatherMoon20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_Sleep}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <Separator Margin="0,2" />
                        <!--  Group 3: Hibernate, Shutdown, Force Shutdown, Restart, Force Restart  -->
                        <UniformGrid Columns="2">
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.Hibernate}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="WeatherSnowflake20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_Hibernate}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.Shutdown}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="Power20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_Shutdown}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.ForceShutdown}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="Flash20" />
                                    <TextBlock
                                        Margin="0,0,30,0"
                                        VerticalAlignment="Center"
                                        Text="{loc:Loc SessionAction_ForceShutdown}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.Restart}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="ArrowCounterclockwise20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_Restart}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                GroupName="Afterwards"
                                IsChecked="{Binding AfterwardsAction, ConverterParameter={x:Static services:SessionAction.ForceRestart}, Converter={StaticResource EnumToBooleanConverter}, Mode=TwoWay}"
                                Style="{StaticResource AfterwardsRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="ArrowCounterclockwiseDashes20" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc SessionAction_ForceRestart}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>