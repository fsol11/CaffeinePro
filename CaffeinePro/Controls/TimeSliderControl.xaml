<UserControl
    x:Class="CaffeinePro.Controls.TimeSliderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CaffeinePro.Converters"
    xmlns:loc="clr-namespace:CaffeinePro.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignWidth="800"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <Style x:Key="QuarterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HourButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Popup
                                x:Name="QuarterPopup"
                                AllowsTransparency="True"
                                IsOpen="False"
                                Placement="Bottom"
                                StaysOpen="True">
                                <Border
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Vertical">
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="0">
                                            <Button.Content>
                                                <!--
                                                    Left to follow the language's own reading
                                                    direction. One string reorders correctly on its
                                                    own, and in Arabic and Farsi that is what puts the
                                                    AM/PM marker on the left of the time.
                                                -->
                                                <TextBlock
                                                    Text="{Binding Converter={StaticResource QuarterTime}, ConverterParameter=0}" />
                                            </Button.Content>
                                        </Button>
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="15">
                                            <Button.Content>
                                                <!--
                                                    Left to follow the language's own reading
                                                    direction. One string reorders correctly on its
                                                    own, and in Arabic and Farsi that is what puts the
                                                    AM/PM marker on the left of the time.
                                                -->
                                                <TextBlock
                                                    Text="{Binding Converter={StaticResource QuarterTime}, ConverterParameter=15}" />
                                            </Button.Content>
                                        </Button>
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="30">
                                            <Button.Content>
                                                <!--
                                                    Left to follow the language's own reading
                                                    direction. One string reorders correctly on its
                                                    own, and in Arabic and Farsi that is what puts the
                                                    AM/PM marker on the left of the time.
                                                -->
                                                <TextBlock
                                                    Text="{Binding Converter={StaticResource QuarterTime}, ConverterParameter=30}" />
                                            </Button.Content>
                                        </Button>
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="45">
                                            <Button.Content>
                                                <!--
                                                    Left to follow the language's own reading
                                                    direction. One string reorders correctly on its
                                                    own, and in Arabic and Farsi that is what puts the
                                                    AM/PM marker on the left of the time.
                                                -->
                                                <TextBlock
                                                    Text="{Binding Converter={StaticResource QuarterTime}, ConverterParameter=45}" />
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter TargetName="QuarterPopup" Property="IsOpen" Value="True" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center">

        <Grid Margin="0,4,0,0">
            <Border
                Margin="0,9,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="4"
                CornerRadius="8" />
            <Border
                Margin="18,2,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource TextFillColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <TextBlock
                    Padding="16,1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorInverseBrush}"
                    Opacity="0.7"
                    Text="{loc:Loc TimeSlider_Until}" />
            </Border>

            <Border Margin="0,9,0,0" Padding="12,16,12,12">
                <StackPanel>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <StackPanel
                            Width="38"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="11"
                                Symbol="WeatherSunny16" />
                            <TextBlock
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="9"
                                Text="{loc:Loc TimeSlider_Am}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AmHours}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="HourButton_Click"
                                        Content="{Binding HourLabel}"
                                        Style="{StaticResource HourButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <StackPanel
                            Width="38"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="11"
                                Symbol="WeatherMoon16" />
                            <TextBlock
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="9"
                                Text="{loc:Loc TimeSlider_Pm}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PmHours}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="HourButton_Click"
                                        Content="{Binding HourLabel}"
                                        Style="{StaticResource HourButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <Grid Margin="0,14,0,0">
            <Border Margin="0,9,0,0" Padding="12,16,12,12">
                <StackPanel>
                    <TextBlock
                        Margin="2,0,0,4"
                        FontSize="9"
                        Opacity="0.5"
                        Text="{loc:Loc TimeSlider_Quick}" />

                    <ItemsControl ItemsSource="{Binding Minutes1}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <MenuItem
                                    Margin="0,-1"
                                    Click="MenuItemOnClick_ActiveFor"
                                    Header="{Binding Converter={StaticResource MinutesToTimeString}}"
                                    StaysOpenOnClick="True"
                                    Tag="{Binding}"
                                    ToolTipService.IsEnabled="{Binding InStartupOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Not}}">
                                    <MenuItem.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource MinutesToActualDateTime}}" />
                                        </ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,8" />

                    <TextBlock
                        Margin="2,0,0,4"
                        FontSize="9"
                        Opacity="0.5"
                        Text="{loc:Loc TimeSlider_Hours}" />
                    <ItemsControl ItemsSource="{Binding Minutes2}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:MenuItem
                                    Margin="0,-1"
                                    Click="MenuItemOnClick_ActiveFor"
                                    Header="{Binding Converter={StaticResource MinutesToTimeString}}"
                                    StaysOpenOnClick="True"
                                    Tag="{Binding}"
                                    ToolTipService.IsEnabled="{Binding InStartupOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Not}}">
                                    <ui:MenuItem.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource MinutesToActualDateTime}}" />
                                        </ToolTip>
                                    </ui:MenuItem.ToolTip>
                                </ui:MenuItem>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Margin="0,7,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Slider
                            Name="MinutesSlider"
                            Width="240"
                            Margin="0,0,5,0"
                            IsSnapToTickEnabled="True"
                            LargeChange="5"
                            Maximum="1440"
                            Minimum="5"
                            SmallChange="1"
                            TickFrequency="5"
                            TickPlacement="None"
                            ValueChanged="MinutesSlider_OnValueChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border
                Margin="0,9,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="4"
                CornerRadius="8" />
            <Border
                Margin="18,2,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource TextFillColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <TextBlock
                    Padding="16,1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorInverseBrush}"
                    Opacity="0.7"
                    Text="{loc:Loc TimeSlider_For}" />
            </Border>
        </Grid>

        <StackPanel
            Height="45"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  The top of the slider's range is not a 24 hour duration, it is "indefinitely"  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                TextAlignment="Center"
                Visibility="{Binding IsIndefinite, Converter={StaticResource BoolToVis}}">
                <Run Text="♾️" />
                <Run Text="{loc:Loc Common_Indefinitely}" />
            </TextBlock>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsIndefinite, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    TextAlignment="Center"
                    Visibility="{Binding IsForSelection, Converter={StaticResource BoolToVis}}">
                    <Run FontSize="14" Text="{loc:Loc TimeSlider_For}" />
                    <Run Text="{Binding ElementName=MinutesSlider, Path=Value, Converter={StaticResource MinutesToTimeString}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextAlignment="Center">
                    <Run FontSize="10" Text="{loc:Loc TimeSlider_Until}" />
                    <Run Text="{Binding ElementName=MinutesSlider, Path=Value, Converter={StaticResource MinutesToActualDateTime}}" />
                    <TextBlock.Style>
                        <!--  In the startup options the app is not running yet, so the clock time a FOR duration lands on is meaningless.  -->
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsForSelection}" Value="True" />
                                        <Condition Binding="{Binding InStartupOptions}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    TextAlignment="Center"
                    Visibility="{Binding IsForSelection, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                    <Run FontSize="14" Text="{loc:Loc TimeSlider_Until}" />
                    <Run>
                        <Run.Text>
                            <MultiBinding Converter="{StaticResource MinutesToActualDateTime}" Mode="OneWay">
                                <Binding ElementName="MinutesSlider" Path="Value" />
                                <Binding Path="InStartupOptions" />
                            </MultiBinding>
                        </Run.Text>
                    </Run>
                </TextBlock>

            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>