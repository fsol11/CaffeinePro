<UserControl
    x:Class="CaffeinePro.Controls.TimeSliderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CaffeinePro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignWidth="800"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="QuarterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HourButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Popup
                                x:Name="QuarterPopup"
                                AllowsTransparency="True"
                                IsOpen="False"
                                Placement="Bottom"
                                StaysOpen="True">
                                <Border
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Vertical">
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                    <Run Text=":00" />
                                                    <Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                    <Run Text=":15" />
                                                    <Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                    <Run Text=":30" />
                                                    <Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                        <Button
                                            Padding="12,4"
                                            Click="QuarterButton_Click"
                                            Style="{StaticResource QuarterButtonStyle}"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                    <Run Text=":45" />
                                                    <Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=2}}" />
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter TargetName="QuarterPopup" Property="IsOpen" Value="True" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center">

        <Grid Margin="0,4,0,6">
            <Separator
                Height="3"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}" />
            <TextBlock
                Padding="6,0"
                HorizontalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                FontSize="11"
                FontWeight="SemiBold"
                Text="Until:" />
        </Grid>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <StackPanel
                Width="38"
                VerticalAlignment="Center"
                Opacity="0.7"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="11"
                    Symbol="WeatherSunny16" />
                <TextBlock
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Text="AM" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding AmHours}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Click="HourButton_Click"
                            Content="{Binding HourLabel}"
                            Style="{StaticResource HourButtonStyle}"
                            Tag="{Binding AmPm}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <StackPanel
                Width="38"
                VerticalAlignment="Center"
                Opacity="0.7"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="11"
                    Symbol="WeatherMoon16" />
                <TextBlock
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Text="PM" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding PmHours}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Click="HourButton_Click"
                            Content="{Binding HourLabel}"
                            Style="{StaticResource HourButtonStyle}"
                            Tag="{Binding AmPm}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Margin="0,6,0,6">
            <Separator
                Height="3"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}" />
            <TextBlock
                Padding="6,0"
                HorizontalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                FontSize="11"
                FontWeight="SemiBold"
                Text="For:" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Minutes1}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <MenuItem
                        Click="MenuItemOnClick_ActiveFor"
                        Header="{Binding Converter={StaticResource MinutesToTimeString}}"
                        StaysOpenOnClick="True"
                        Tag="{Binding}">
                        <MenuItem.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource MinutesToActualDateTime}}" />
                            </ToolTip>
                        </MenuItem.ToolTip>
                    </MenuItem>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator />

        <ItemsControl ItemsSource="{Binding Minutes2}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:MenuItem
                        Click="MenuItemOnClick_ActiveFor"
                        Header="{Binding Converter={StaticResource MinutesToTimeString}}"
                        StaysOpenOnClick="True"
                        Tag="{Binding}">
                        <ui:MenuItem.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource MinutesToActualDateTime}}" />
                            </ToolTip>
                        </ui:MenuItem.ToolTip>
                    </ui:MenuItem>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Slider
                Name="MinutesSlider"
                Width="240"
                Margin="0,7,5,0"
                IsSnapToTickEnabled="True"
                LargeChange="15"
                Maximum="1439"
                Minimum="5"
                SmallChange="1"
                TickFrequency="15"
                TickPlacement="None" />
            <TextBlock
                Width="50"
                Padding="0,5,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Arial"
                FontSize="12pt"
                Opacity=".5"
                Text="{Binding ElementName=MinutesSlider, Path=Value, Converter={StaticResource MinutesToTimeString}, ConverterParameter={x:Static converters:TimeStringFormat.Relative}}"
                TextAlignment="Center" />
        </StackPanel>

        <TextBlock
            Padding="5,20,0,0"
            HorizontalAlignment="Center"
            FontSize="20"
            Text="{Binding ElementName=MinutesSlider, Path=Value, Converter={StaticResource MinutesToActualDateTime}}"
            TextAlignment="Center"
            Visibility="{Binding InStartupOptions, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}" />

    </StackPanel>
</UserControl>