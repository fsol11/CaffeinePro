<UserControl x:Class="CaffeinePro.Controls.RelativeTime"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:CaffeinePro.Converters"
             mc:Ignorable="d"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             >

    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBlock 
                Text="{Binding Minutes, Converter={StaticResource MinutesToTimeString}, ConverterParameter={x:Static converters:TimeStringFormat.Relative}}"/>
            <TextBlock Padding="5 0" FontSize="12"
                       Text="{Binding Minutes, Converter={StaticResource MinutesToActualDateTime}, StringFormat={}({0})}" />

        </StackPanel>
    </Grid>
</UserControl>